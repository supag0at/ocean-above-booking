# Ed25519 private key in PKCS#8 PEM. Generate (example):
#   openssl genpkey -algorithm ed25519 -out infra/secrets/hands_token_signing_key
#   openssl pkey -in infra/secrets/hands_token_signing_key -pubout -out infra/secrets/hands_token_public_key.pem
# The real file is gitignored. Never commit a PEM block here.
