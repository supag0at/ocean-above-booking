# SITE_ADDRESS=:80 keeps Caddy on HTTP only. A bare hostname turns automatic HTTPS on (D-23).
# /api is proxied without buffering so SSE frames flush immediately.
{$SITE_ADDRESS} {
	handle /api/* {
		reverse_proxy 172.30.1.20:8080 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle {
		root * /srv
		encode gzip
		try_files {path} /index.html
		file_server
	}
}
