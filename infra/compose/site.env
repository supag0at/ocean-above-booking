# Non-secret site settings (A-01 §10, D-23). No credentials.
# TLS ends at Cloudflare. Caddy stays on HTTP. The browser origin is https://g0at.top.
# The containers that are already running keep the previous values until they are recreated.
SITE_ADDRESS=:80
PUBLIC_ORIGIN=https://g0at.top
COOKIE_SECURE=1
